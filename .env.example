# portfolio-v6-admin environment (spec §9.6)
# Vite exposes only VITE_-prefixed vars to the client via import.meta.env.
# `process` does not exist at runtime — never use process.env.* in app code.

# Empty locally so requests are same-origin and the Vite dev proxy (§10) handles /api.
VITE_API_BASE_URL=

# Cognito (SRP, public SPA client — no client secret). Prod vs dev pool per environment.
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-east-1

# Public site hostname — the preview iframe target (§7). Becomes benkile.com at cutover.
VITE_PUBLIC_SITE_URL=https://v6.benkile.com

# CDN base for media thumbnails (§6.8). Used only if the admin media list does not already
# return a resolved `url`; otherwise the API-resolved URL wins. Leave empty to fall back to
# the raw s3_key.
VITE_CDN_URL=https://media.benkile.com
